# Nummi — contoh environment. Salin jadi `.env.local`, lalu isi.
#
# `.env*` sudah gitignored kecuali berkas ini. JANGAN pernah meng-commit nilai sungguhan.

# ── Supabase ──────────────────────────────────────────────────────────────────

# URL project. Ikut ke browser — wajar, ia bukan rahasia.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Kunci publik (`sb_publishable_…`). Ikut ke browser dengan sengaja — yang menjaga data adalah
# RLS (migrasi 0002/0009), bukan kerahasiaan kunci ini.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Kunci rahasia (`sb_secret_…`). SERVER SAJA — route handler, Edge Function, skrip.
#
# ⚠️ Jangan pernah menamainya berawalan `NEXT_PUBLIC_`. Next MENANAMKAN setiap `NEXT_PUBLIC_*`
# ke bundle klien saat build, jadi salah nama satu kali = kunci ini terbit ke setiap pengunjung.
# Sejak migrasi 0009 ia satu-satunya jalan menulis ledger.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# ── Console (Tahap 4) ─────────────────────────────────────────────────────────

# Email admin yang boleh membuka /console, dipisah koma. Kosong = tidak ada yang bisa masuk.
# Console tidak pernah membawa kunci rahasia ke klien (ADR-0021 + pelajaran P0 repo lama:
# console pernah menerbitkan data semua keluarga sebagai HTML statis).
CONSOLE_ADMIN_EMAILS=

# ── seed:dev (opsional, dev saja) ─────────────────────────────────────────────
#
# `pnpm seed:dev` MENOLAK jalan sampai project-nya disebut eksplisit. Isi dengan ref project
# (bagian pertama hostname Supabase). Gerbang ini mencegah kecelakaan paling mungkin: `.env`
# masih menunjuk project sungguhan sementara orangnya mengira menunjuk yang lain.
NUMMI_SEED_PROJECT_REF=

# Bisa ditimpa kalau nilai bawaannya tidak cocok:
# NUMMI_SEED_EMAIL=dev-parent@nummi.local
# NUMMI_SEED_PASSWORD=nummi-dev-password
# NUMMI_SEED_CHILD=Arthur
# NUMMI_SEED_PIN=135790

# ── YANG SENGAJA TIDAK ADA DI SINI ────────────────────────────────────────────
#
# CHILD_JWT_SECRET — dipakai Edge Function `child-login` yang berjalan di SUPABASE, bukan di
# Vercel. Memasangnya di sini hanya menambah satu tempat lagi rahasia itu berada.
